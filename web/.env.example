DATABASE_URL=file:./kardef.db
PAYLOAD_SECRET=uzun-rastgele-bir-anahtar
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

SEED_ADMIN_EMAIL=yonetici@kardef.test
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=editor@kardef.test
SEED_EDITOR_PASSWORD=
SEED_AUTHOR_EMAIL=yazar@kardef.test
SEED_AUTHOR_PASSWORD=

# Otomatik çeviri (Microsoft Translator ücretsiz paket F0). Boş bırakılırsa çeviri kapalıdır.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope

# Arşive katkı formu: Cloudflare Turnstile (robot doğrulaması). İkisi birlikte doldurulmalı.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Ziyaretçi IP'sinin okunacağı başlık (nginx: x-real-ip, Cloudflare arkasında: cf-connecting-ip)
TRUSTED_IP_HEADER=x-real-ip
